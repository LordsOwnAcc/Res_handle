# Local Postgres connection (matches docker-compose.yml in the repo root, if you use it)
PGHOST=localhost
PGPORT=5432
PGDATABASE=resumeintel
PGUSER=postgres
PGPASSWORD=postgres

# Frontend origin allowed to call this API (Vite's default dev port)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Google Drive file storage — optional, leave blank to skip file upload entirely.
# See README "Google Drive setup" for how to get these two values.
GOOGLE_DRIVE_CREDENTIALS_BASE64=
GOOGLE_DRIVE_FOLDER_ID=

PORT=8080
